# LifeGuard AI Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=lifeguard_ai

# JWT Secret for User Authentication
JWT_SECRET=lifeguard_ai_secure_jwt_token_secret_2026_xyz

# Google Gemini API Key (Backend only - NEVER expose on Android client)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional: Path to Firebase Admin SDK service account key JSON for FCM Push
# FIREBASE_SERVICE_ACCOUNT_KEY=./config/firebaseServiceAccount.json
