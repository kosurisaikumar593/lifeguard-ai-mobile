# LifeGuard AI — Backend Server Environment Configuration

PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection
# Option 1: Full Connection String (Neon, Supabase Postgres, Railway, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifeguard_db

# Option 2: Individual Connection Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=lifeguard_db
