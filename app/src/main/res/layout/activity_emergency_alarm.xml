<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/sos_red"
    android:padding="32dp">

    <ImageView
        android:id="@+id/ivAlarmBell"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_alarm"
        android:tint="@color/surface_white"
        android:contentDescription="Alarm" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="EMERGENCY ALARM ACTIVE"
        android:textColor="@color/surface_white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Audible siren playing at maximum volume"
        android:textColor="@color/surface_white"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnStopAlarm"
        style="@style/LifeGuardButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="STOP ALARM"
        android:textColor="@color/sos_red"
        android:backgroundTint="@color/surface_white" />

</LinearLayout>
