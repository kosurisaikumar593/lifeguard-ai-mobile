<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Emergency Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_rounded"
            android:backgroundTint="@color/sos_red"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 EMERGENCY ALERT ACTIVE"
                android:textColor="@color/surface_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmergencySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Safety protocol initiated. Contacts notified."
                android:textColor="@color/surface_white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Delivery Status Timeline Card (Page 18 & 30 of reference) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALERT DELIVERY TIMELINE"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimelinePreparing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="✓ 1. Emergency Event Created"
                android:textColor="@color/active_green_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimelineLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="✓ 2. Current GPS Location Acquired"
                android:textColor="@color/active_green_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimelineServer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="✓ 3. Accepted by LifeGuard Server"
                android:textColor="@color/active_green_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimelineContacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="⏳ 4. FCM Alerts Sent to Contacts"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimelineAck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="⏳ 5. Awaiting Contact Acknowledgement"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Incident Details Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvEventDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detection: Possible distress-like human sound\nSound Level: 93 dB\nLocation: Acquired"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Alarm Toggle Button -->
        <Button
            android:id="@+id/btnToggleAlarm"
            style="@style/LifeGuardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="STOP ALARM"
            android:backgroundTint="@color/sos_red" />

        <!-- Emergency Helplines: 112 & 108 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCall112"
                style="@style/LifeGuardButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CALL 112"
                android:backgroundTint="@color/primary_blue" />

            <View
                android:layout_width="12dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnCall108"
                style="@style/LifeGuardButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CALL 108"
                android:backgroundTint="@color/sos_red" />
        </LinearLayout>

        <Button
            android:id="@+id/btnNearbyHospitals"
            style="@style/LifeGuardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="FIND NEARBY HOSPITALS"
            android:textColor="@color/primary_blue"
            android:backgroundTint="@color/primary_blue_light" />

        <Button
            android:id="@+id/btnViewLocationMap"
            style="@style/LifeGuardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="OPEN IN MAP"
            android:textColor="@color/active_green_dark"
            android:backgroundTint="@color/active_green_light" />

        <Button
            android:id="@+id/btnReturnHome"
            style="@style/LifeGuardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="RETURN TO DASHBOARD"
            android:textColor="@color/text_secondary"
            android:backgroundTint="@android:color/transparent" />

    </LinearLayout>
</ScrollView>
