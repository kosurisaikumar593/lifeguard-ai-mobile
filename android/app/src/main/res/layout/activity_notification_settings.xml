<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:padding="24dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_back"
        android:contentDescription="Back"
        android:background="?attr/selectableItemBackgroundBorderless" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Notification Settings"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/card_rounded"
        android:orientation="vertical"
        android:padding="20dp">

        <CheckBox
            android:id="@+id/cbEmergencyPush"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="High-Priority Emergency Alerts\nReceive alerts when contacts are in distress"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:checked="true"
            android:padding="8dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_border" android:layout_marginVertical="8dp" />

        <CheckBox
            android:id="@+id/cbSirenAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Audible Siren Alarm\nPlay loud emergency siren during emergencies"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:checked="true"
            android:padding="8dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_border" android:layout_marginVertical="8dp" />

        <CheckBox
            android:id="@+id/cbContactInvitations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contact Invitation Alerts\nNotify when friends invite you to connect"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:checked="true"
            android:padding="8dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnTestNotification"
        style="@style/LifeGuardButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="TEST SAFETY NOTIFICATION"
        android:textColor="@color/primary_blue"
        android:backgroundTint="@color/primary_blue_light" />

    <Button
        android:id="@+id/btnSaveNotifications"
        style="@style/LifeGuardButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SAVE PREFERENCES"
        android:backgroundTint="@color/primary_blue" />

</LinearLayout>
