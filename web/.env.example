# =====================================================================
# LifeGuard AI — Environment Configuration
# =====================================================================

# --- 1. SUPABASE (Primary / Recommended BaaS) ---
# Create a free project at https://supabase.com
# Find these in Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- 2. FIREBASE (Alternative BaaS) ---
# Create a project at https://console.firebase.google.com
# Find these in Project Settings -> General -> Your Apps (Web App)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=lifeguard-ai-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lifeguard-ai-app
VITE_FIREBASE_STORAGE_BUCKET=lifeguard-ai-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef...

# --- 3. CUSTOM NODE.JS / EXPRESS + POSTGRESQL (Self-Hosted Backend) ---
# Run the server in /server (npm start) on port 5000
VITE_BACKEND_API_URL=http://localhost:5000
VITE_BACKEND_SOCKET_URL=http://localhost:5000

# --- 4. BACKEND PROVIDER SELECTION ---
# Options: 'AUTO' | 'SUPABASE' | 'FIREBASE' | 'NODE_EXPRESS' | 'LOCAL'
# If AUTO, LifeGuard AI detects configured credentials and falls back gracefully to local storage.
VITE_BACKEND_PROVIDER=AUTO
